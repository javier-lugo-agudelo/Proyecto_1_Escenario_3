# ============================================================
# Copiar este archivo como jenkins/.env y completar los valores
# NUNCA subir jenkins/.env al repositorio
# ============================================================

# Contraseña del usuario admin de Jenkins (acceso a la interfaz web)
JENKINS_ADMIN_PASSWORD=CambiarEstaContrasena123

# Contraseña de PostgreSQL — debe coincidir con el .env del proyecto
JENKINS_DB_PASSWORD=inventario_pass

# Secret key de Flask — debe coincidir con el .env del proyecto
JENKINS_SECRET_KEY=mi_clave_secreta_flask

# URL del repositorio GitHub (sin credenciales para repos públicos)
GITHUB_REPO_URL=https://github.com/javier-lugo-agudelo/Proyecto_2_Semana_5
